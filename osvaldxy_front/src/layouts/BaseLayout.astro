---
import '../styles/global.css';
import Button from '../components/Button.astro';
//Props so each page could have a unique title
const {title = "Osvaldxy"} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{title}</title>
    </head>
    <body class="bg-principal min-h-screen">
        <nav class=" mt-2.5 mb-2.5 bg-black-50 max-w-6xl mx-auto flex justify-between items-center">
            <a href="/" class="font-bold text-xl text-secundario">Osvaldxy</a>
            <div class="space-x-4">
                <Button link="/gallery" text='Gallery'></Button>
                <Button link="/albums" text="Albums"></Button>
            </div>
            
        </nav>

        <main>
            <slot />
        </main>

        <footer class="text-center py-10 text-white text-sm">
            &copy; 2026 Derechos reservados Osvaldo Reyes Meneses
        </footer>
    </body>
</html>
