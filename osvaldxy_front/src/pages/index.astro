---
import BaseLayout from '../layouts/BaseLayout.astro';

const response = await fetch('http://127.0.0.1:8000/api/media');
const media = await response.json();
const backendUrl = "http://127.0.0.1:8000"; 

---

<BaseLayout>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-1">
        <div class="bg-terciario rounded-lg ml-2.5 md: col-span-1 flex flex-col items-center">
            <h1 class="font-mono text-4xl font-bold text-gray-900 mb-4">Capturando</h1>
            <h1 class="font-mono text-4xl font-bold text-gray-900 mb-4">Momentos...</h1>
            <p class="font-sans text-gray-600">lorem ipsum lorem ipsum lorem ipsum</p>
        </div>

        <div class="md:col-span-2">
            <div class="columns-1 md:columns-2 gap-4" style="">
                { Array.isArray(media) ? (
                    media.map((photo) => ( 
                        <div class="mb-4 pr-2.5 pl-2.5">
                            <img class="rounded-lg hover:shadow-sm shadow-gray-50 transition-shadow" src={`${backendUrl}${photo.path_url}`} alt=$"http:127.0.0.1:8000"+`{photo.path_url}`/>
                        </div>
                        ))) : (

                        <div>
                            <h2>No media here :(</h2>
                        </div>
                )}
            </div>
        </div>
    </div>
</BaseLayout>
